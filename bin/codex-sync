#!/usr/bin/env python3
"""Share Claude Code's skills, rules and guard hooks with Codex CLI, from one source.

Claude's files stay the only copy you edit. Run it again whenever they change, or from
a Claude Code SessionStart hook (see the README); every step is idempotent.

1. Skills. Links each skill folder in ~/.claude/skills into ~/.agents/skills, which
   is Codex's user skill folder (Codex follows symlinks). Skips names Codex already
   has there or in $CODEX_HOME/skills, names starting with "_" or ".", and the skills
   that would make Codex call Codex. Removes links it made whose skill is gone.
2. Rules. Writes $CODEX_HOME/AGENTS.md from ~/.claude/CLAUDE.md. A line that imports
   a file (`@TOOLING.md`) becomes a pointer to read that file when its topic comes up,
   so Codex gets the core rules every turn without paying for every imported file.
   It replaces AGENTS.md only when it is missing, a link into ~/.claude (the old way
   of sharing it; the old target is printed), or a file whose first line says it was
   written by this script. If CLAUDE.md goes away, it removes its own AGENTS.md.
3. Hooks. Writes $CODEX_HOME/hooks.json with the handlers of Claude's PreToolUse and
   PostToolUse groups whose matcher is exactly "Bash": Codex sends Bash the same
   tool_input.command as Claude. Groups for Edit, Write or other tools are skipped and
   listed (Codex's payloads for them differ), as are Prompt, Stop and SessionStart
   hooks, which read Claude's own files. It replaces hooks.json only when it is
   missing or a regular file whose "description" says it was written by this script
   (a symlink is never replaced), and removes its own when nothing is left to share.
   A settings.json it cannot parse is an error (exit 1) and leaves hooks.json as it
   was. Codex runs a new or changed hook only after you trust it once in /hooks.
4. Says so if config.toml's project_doc_fallback_filenames lacks "CLAUDE.md" (so Codex
   cannot read a project's CLAUDE.md where it has no AGENTS.md; needs Python 3.11+),
   or if a non-empty $CODEX_HOME/AGENTS.override.md hides the generated AGENTS.md.

Files are written through a temp file and renamed, keeping the old file's mode (new
files are 0600). $CLAUDE_CONFIG_DIR and $CODEX_HOME are made absolute first.

  codex-sync            apply
  codex-sync --dry-run  print what it would change
  codex-sync --quiet    print only changes and problems
  codex-sync --selftest
  codex-sync --help     this text; unknown options exit 2 without changing anything
"""
import argparse
import json
import os
import re
import sys
import tempfile

MARK = "generated by codex-sync"
SKIP_SKILLS = {"codex", "codex-worker"}
SHARED_EVENTS = ("PreToolUse", "PostToolUse")
SHARED_MATCHER = "Bash"


def paths(home=None):
    home = home or os.path.expanduser("~")
    claude = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(home, ".claude")
    codex = os.environ.get("CODEX_HOME") or os.path.join(home, ".codex")
    return (os.path.abspath(os.path.expanduser(claude)), os.path.abspath(os.path.expanduser(codex)),
            os.path.join(home, ".agents", "skills"))


def mklink(target, link):
    try:
        os.symlink(target, link)
    except FileExistsError:  # a second run got there first
        pass


def sync_skills(claude, codex, agents, act):
    src = os.path.join(claude, "skills")
    if not os.path.isdir(src):
        return
    act(lambda: os.makedirs(agents, exist_ok=True), None)
    codex_own = set(os.listdir(os.path.join(codex, "skills"))) if os.path.isdir(os.path.join(codex, "skills")) else set()
    existing = set(os.listdir(agents)) if os.path.isdir(agents) else set()
    for name in sorted(os.listdir(src)):
        target = os.path.join(src, name)
        if (name[0] in "_." or name in SKIP_SKILLS or name in codex_own or name in existing
                or not os.path.isfile(os.path.join(target, "SKILL.md"))):
            continue
        link = os.path.join(agents, name)
        act(lambda t=target, l=link: mklink(t, l), f"skill: linked {name}")
    for name in sorted(existing):
        link = os.path.join(agents, name)
        # only links into the Claude skills folder; one that is dead because its skill went away
        if os.path.islink(link) and not os.path.exists(link) and \
                os.path.abspath(os.path.join(agents, os.readlink(link))).startswith(src + os.sep):
            act(lambda l=link: os.unlink(l), f"skill: removed dead link {name}")


def agents_md(claude_md):
    out = [f"<!-- {MARK} from {claude_md}; edit that file, not this one -->", ""]
    base = os.path.dirname(claude_md)
    with open(claude_md, encoding="utf-8") as fh:
        lines = fh.read().splitlines()
    for line in lines:
        m = re.fullmatch(r"@(\S+)", line.strip())
        if m:
            ref = os.path.join(base, m.group(1))
            out.append(f"(Read `{ref}` before work this section covers; Claude loads it automatically, Codex reads it on demand.)")
        else:
            out.append(line)
    return "\n".join(out) + "\n"


def managed(path, claude, label):
    """May codex-sync replace or remove path? Missing: yes. A link: only AGENTS.md into the Claude folder."""
    if not os.path.lexists(path):
        return True
    if os.path.islink(path):
        return label == "rules" and os.path.realpath(path).startswith(os.path.realpath(claude) + os.sep)
    try:
        with open(path, encoding="utf-8") as fh:
            if label == "rules":
                return MARK in fh.readline()
            return MARK in str(json.load(fh).get("description", ""))
    except (OSError, ValueError, AttributeError):  # unreadable, not JSON, or not an object
        return False


def atomic_write(path, text):
    # the old file's mode if there was one (never a link's), else owner-only
    mode = os.stat(path).st_mode & 0o777 if os.path.isfile(path) and not os.path.islink(path) else 0o600
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".codex-sync-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def sync_file(path, text, claude, act, say, label):
    """Write text to path; text None means the source is gone, so remove what we generated."""
    mine = managed(path, claude, label)
    if text is None:
        if mine and os.path.isfile(path) and not os.path.islink(path):
            act(lambda: os.unlink(path), f"{label}: removed {path}, its source is gone")
        return
    if not mine:
        say(f"{label}: left alone, {path} is not ours (move it away to let codex-sync manage it)")
        return
    link = os.path.islink(path)
    if not link and os.path.exists(path):
        with open(path, encoding="utf-8", errors="replace") as fh:
            if fh.read() == text:
                return
    old = f"; replaced link -> {os.readlink(path)}" if link else ""
    act(lambda: atomic_write(path, text), f"{label}: wrote {path}{old}")


def hooks_json(settings_path, note):
    """The hooks.json text, or None when there is nothing to share. Raises on unreadable settings."""
    with open(settings_path, encoding="utf-8") as fh:
        hooks = json.load(fh).get("hooks") or {}
    shared = {}
    for ev in SHARED_EVENTS:
        for g in hooks.get(ev) or []:
            if isinstance(g, dict) and g.get("matcher") == SHARED_MATCHER:
                # Codex runs command handlers only; other handler types stay with Claude
                cmds = [h for h in g.get("hooks") or [] if isinstance(h, dict) and h.get("type") == "command"]
                if cmds:
                    shared.setdefault(ev, []).append({**g, "hooks": cmds})
            else:
                m = g.get("matcher") if isinstance(g, dict) else None
                note(f"hooks: skipped a {ev} group (matcher {m!r}); only {SHARED_MATCHER!r} is shared with Codex")
    return json.dumps({"description": f"{MARK} from {settings_path}; edit that file, not this one",
                       "hooks": shared}, indent=2) + "\n" if shared else None


def fallback_missing(cfg):
    """True when config.toml (Python 3.11+ only) does not list CLAUDE.md in project_doc_fallback_filenames."""
    try:
        import tomllib
    except ImportError:
        return False
    try:
        with open(cfg, "rb") as fh:
            names = tomllib.load(fh).get("project_doc_fallback_filenames")
    except FileNotFoundError:
        names = None
    except (OSError, ValueError):  # unreadable or not valid TOML: skip the check
        return False
    return not (isinstance(names, list) and "CLAUDE.md" in names)


def run(home=None, dry=False, quiet=False):
    claude, codex, agents = paths(home)
    changes, problems = [], []

    def say(msg):  # a problem the user should see, even when quiet
        problems.append(msg)
        print(msg)

    def note(msg):
        if not quiet:
            print(msg)

    def act(fn, msg):
        if not dry:
            fn()
        if msg:
            changes.append(msg)
            print(("would: " if dry else "") + msg)

    if not os.path.isdir(codex):
        say(f"codex-sync: no Codex home at {codex}; sign in to Codex first")
        return 1
    status = 0
    sync_skills(claude, codex, agents, act)
    claude_md = os.path.join(claude, "CLAUDE.md")
    sync_file(os.path.join(codex, "AGENTS.md"), agents_md(claude_md) if os.path.isfile(claude_md) else None,
              claude, act, say, "rules")
    settings, hooks_path = os.path.join(claude, "settings.json"), os.path.join(codex, "hooks.json")
    try:
        text = hooks_json(settings, note) if os.path.exists(settings) else None
    except (OSError, ValueError, AttributeError, TypeError) as e:  # keep the old hooks.json: it may be what the user trusted
        say(f"hooks: cannot read {settings} ({e}); {hooks_path} left as it was")
        status = 1
    else:
        sync_file(hooks_path, text, claude, act, say, "hooks")
    if fallback_missing(os.path.join(codex, "config.toml")):
        say(f'hint: make project_doc_fallback_filenames in {os.path.join(codex, "config.toml")} include "CLAUDE.md" '
            '(append it to the list if the key exists; else add  project_doc_fallback_filenames = ["CLAUDE.md"]  above the first [table])')
    override = os.path.join(codex, "AGENTS.override.md")
    if os.path.isfile(override) and os.path.getsize(override):
        say(f"note: {override} is not empty, so Codex reads it instead of the generated AGENTS.md")
    if not changes and not problems and not quiet:
        print("codex-sync: up to date")
    return status


def main(argv, home=None):
    ap = argparse.ArgumentParser(prog="codex-sync", description=__doc__, allow_abbrev=False,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dry-run", action="store_true", help="print what it would change")
    ap.add_argument("--quiet", action="store_true", help="print only changes and problems")
    ap.add_argument("--selftest", action="store_true", help="check the script against a temp folder")
    a = ap.parse_args(argv)  # an unknown option exits 2 here, before anything is touched
    return selftest() if a.selftest else run(home, a.dry_run, a.quiet)


def selftest():
    import contextlib
    import io
    import tempfile
    for k in ("CLAUDE_CONFIG_DIR", "CODEX_HOME"):
        os.environ.pop(k, None)  # never let the test reach the real folders
    try:
        import tomllib
    except ImportError:
        tomllib = None

    def go(home, **kw):
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            rc = run(home, **kw)
        return rc, buf.getvalue()

    def cli(argv, home):
        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            try:
                return main(argv, home)
            except SystemExit as e:
                return e.code

    def put(path, text):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as fh:
            fh.write(text)

    def get(path):
        with open(path) as fh:
            return fh.read()

    def tree(home):
        return [(d, sorted(ds), sorted(fs)) for d, ds, fs in sorted(os.walk(home))]

    bash = {"matcher": "Bash", "hooks": [{"type": "command", "command": "/g.sh"}]}
    edit = {"matcher": "Edit|Write", "hooks": [{"type": "command", "command": "/e.sh"}]}
    bare = {"hooks": [{"type": "command", "command": "/b.sh"}]}

    def fixture(home, hooks):
        claude, codex, agents = paths(home)
        for d in ("alpha", "_private", "codex", "shared"):
            put(os.path.join(claude, "skills", d, "SKILL.md"), "---\nname: x\n---\n")
        os.makedirs(os.path.join(claude, "skills", "notaskill"))
        os.makedirs(os.path.join(agents, "shared"))  # Codex already has it
        put(os.path.join(claude, "CLAUDE.md"), "# Rules\n\n@TOOLING.md\nbe brief\n")
        put(os.path.join(claude, "settings.json"), json.dumps({"hooks": hooks, "env": {"SECRET": "x"}}))
        put(os.path.join(codex, "config.toml"), 'project_doc_fallback_filenames = ["CLAUDE.md"]\n')
        return claude, codex, agents

    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as fresh:
        # arguments are parsed first: typos and --help change nothing, --dry-run only reports
        fixture(fresh, {"PreToolUse": [bash]})
        before = tree(fresh)
        assert cli(["--dryrun"], fresh) == 2 and cli(["--bogus"], fresh) == 2 and cli(["--help"], fresh) == 0
        rc, out = go(fresh, dry=True)
        assert rc == 0 and "would: skill: linked alpha" in out and tree(fresh) == before, out

        claude, codex, agents = fixture(home, {"PreToolUse": [bash, edit], "PostToolUse": [bare],
                                               "UserPromptSubmit": [bare]})
        settings, hj, am = os.path.join(claude, "settings.json"), os.path.join(codex, "hooks.json"), os.path.join(codex, "AGENTS.md")
        os.symlink(os.path.join(claude, "TOOLING.md"), am)  # the old way of sharing the rules
        rc, out = go(home)
        assert rc == 0
        assert f"replaced link -> {os.path.join(claude, 'TOOLING.md')}" in out, out
        md = get(am)
        assert not os.path.islink(am) and MARK in md.splitlines()[0], md
        assert "be brief" in md and "TOOLING.md` before work" in md and "@TOOLING" not in md, md
        assert sorted(os.listdir(agents)) == ["alpha", "shared"], os.listdir(agents)
        assert os.path.islink(os.path.join(agents, "alpha"))
        # only the Bash group is shared; the other PreToolUse/PostToolUse groups are listed as skipped
        hooks = json.load(open(hj))
        assert hooks["hooks"] == {"PreToolUse": [bash]} and "SECRET" not in json.dumps(hooks), hooks
        assert "skipped a PreToolUse group (matcher 'Edit|Write')" in out and "skipped a PostToolUse group (matcher None)" in out, out
        assert all(os.stat(f).st_mode & 0o777 == 0o600 for f in (am, hj))  # new files are owner-only
        assert go(home, quiet=True) == (0, "")  # idempotent, and --quiet hides the skipped groups
        assert "up to date" in go(home)[1]
        # an edit keeps the file's mode and leaves no temp file behind
        os.chmod(hj, 0o640)
        put(settings, json.dumps({"hooks": {"PreToolUse": [bash, bash]}}))
        assert go(home, quiet=True)[0] == 0 and len(json.load(open(hj))["hooks"]["PreToolUse"]) == 2
        assert os.stat(hj).st_mode & 0o777 == 0o640 and not [n for n in os.listdir(codex) if n.startswith(".codex-sync-")]
        # a settings.json that does not parse: report, exit 1, hooks.json untouched
        good = get(hj)
        put(settings, "{not json")
        rc, out = go(home, quiet=True)
        assert rc == 1 and "cannot read" in out and get(hj) == good, out
        # nothing shareable left, or settings.json gone: our hooks.json goes
        put(settings, json.dumps({"hooks": {"Stop": [bare]}}))
        assert "hooks: removed" in go(home, quiet=True)[1] and not os.path.lexists(hj)
        put(settings, json.dumps({"hooks": {"PreToolUse": [bash]}}))
        go(home, quiet=True)
        os.unlink(settings)
        assert "hooks: removed" in go(home, quiet=True)[1] and not os.path.lexists(hj)
        # a symlinked hooks.json is never replaced, even when the source changes
        mine = os.path.join(claude, "my-hooks.json")
        put(mine, '{"hooks": {}}')
        os.symlink(mine, hj)
        put(settings, json.dumps({"hooks": {"PreToolUse": [bash]}}))
        out = go(home, quiet=True)[1]
        assert os.path.islink(hj) and get(mine) == '{"hooks": {}}' and "left alone" in out, out
        # nor is a regular file that only mentions the marker somewhere other than its description / first line
        os.unlink(hj)
        put(hj, '{"hooks": {}, "other": "generated by codex-sync"}')
        go(home, quiet=True)
        assert get(hj) == '{"hooks": {}, "other": "generated by codex-sync"}'
        os.unlink(am)
        put(am, "my own rules\n<!-- generated by codex-sync -->\n")
        assert "left alone" in go(home, quiet=True)[1] and get(am).startswith("my own rules")
        os.unlink(settings)
        os.unlink(os.path.join(claude, "CLAUDE.md"))
        go(home, quiet=True)
        assert get(am).startswith("my own rules") and os.path.exists(hj)  # hand-written files are never removed
        # the rules go when CLAUDE.md goes (only a file we generated)
        os.unlink(am)
        put(os.path.join(claude, "CLAUDE.md"), "# Rules\n")
        go(home, quiet=True)
        os.unlink(os.path.join(claude, "CLAUDE.md"))
        assert "rules: removed" in go(home, quiet=True)[1] and not os.path.lexists(am)
        # skills: a dead link into the Claude skills folder goes, a hand-made one elsewhere stays
        os.symlink(os.path.join(home, "elsewhere", "gone"), os.path.join(agents, "mine"))
        os.unlink(os.path.join(claude, "skills", "alpha", "SKILL.md"))
        os.rmdir(os.path.join(claude, "skills", "alpha"))
        go(home, quiet=True)
        assert sorted(os.listdir(agents)) == ["mine", "shared"], os.listdir(agents)
        # a link that already exists (a second run got there first) is not an error
        mklink("/x", os.path.join(home, "l"))
        mklink("/x", os.path.join(home, "l"))
        # config.toml: the effective list decides the hint; AGENTS.override.md is reported
        cfg = os.path.join(codex, "config.toml")
        if tomllib:
            for body, hint in (('project_doc_fallback_filenames = ["TEAM_GUIDE.md"]\n', True),
                               ('# project_doc_fallback_filenames = ["CLAUDE.md"]\n', True),
                               ('project_doc_fallback_filenames = ["TEAM_GUIDE.md", "CLAUDE.md"]\n', False),
                               ("not [valid", False)):
                put(cfg, body)
                assert ("hint:" in go(home, quiet=True)[1]) == hint, body
            os.unlink(cfg)
            assert "hint:" in go(home, quiet=True)[1]
        put(os.path.join(codex, "AGENTS.override.md"), "")
        assert "AGENTS.override.md" not in go(home, quiet=True)[1]
        put(os.path.join(codex, "AGENTS.override.md"), "x\n")
        assert "AGENTS.override.md" in go(home, quiet=True)[1]
        # a relative CLAUDE_CONFIG_DIR becomes absolute before any link is made
        cwd = os.getcwd()
        os.chdir(home)
        try:
            os.environ["CLAUDE_CONFIG_DIR"] = "rel-claude"
            assert paths(home)[0] == os.path.join(os.getcwd(), "rel-claude")
        finally:
            os.chdir(cwd)
            os.environ.pop("CLAUDE_CONFIG_DIR")
    print("selftest ok")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
